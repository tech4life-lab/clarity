# Copy to `.env.local` for local dev (Vite reads env at startup — restart after changes).
# Supabase Dashboard → Settings → API: Project URL + anon public key ONLY.
# Never put the service_role secret in Vite, React, or any frontend bundle.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Paste the full anon/public JWT from Dashboard → Settings → API (not a short fragment).
VITE_SUPABASE_ANON_KEY=

# PostHog (optional — analytics no-ops if omitted)
VITE_PUBLIC_POSTHOG_KEY=
# Use the ingest host for your region, e.g. https://us.i.posthog.com or https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Legacy names (still supported by the app):
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=

# Deploy + funnel checklist: docs/demand-validation.md
